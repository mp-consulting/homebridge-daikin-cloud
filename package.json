{
  "displayName": "Daikin Cloud",
  "platformname": "daikincloud",
  "name": "@mp-consulting/homebridge-daikin-cloud",
  "version": "1.7.0",
  "description": "Integrate with the Daikin Cloud to control your Daikin air conditioning via the cloud",
  "license": "(Apache-2.0 AND MIT)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mp-consulting/homebridge-daikin-cloud.git"
  },
  "bugs": {
    "url": "https://github.com/mp-consulting/homebridge-daikin-cloud/issues"
  },
  "engines": {
    "node": "^20.5.0 || ^22.10.0 || ^24.0.0 || ^26.0.0",
    "homebridge": ">=1.5.0 || ^2.0.0-beta.0"
  },
  "main": "dist/src/index.js",
  "customUi": true,
  "customUiPath": "./homebridge-ui",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "smoke:ui": "node scripts/smoke-ui-server.js",
    "schema:check": "tsx scripts/check-schema-drift.ts",
    "watch": "npm run build && npm link && nodemon",
    "copy:ui-kit": "mp-ui-kit-copy --vendor",
    "build": "npm run copy:ui-kit && rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build",
    "release": "npm publish",
    "release:beta": "npm publish --tag beta"
  },
  "keywords": [
    "homebridge-plugin"
  ],
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6",
    "@mp-consulting/homebridge-ai-core": "^2.0.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mp-consulting/homebridge-ui-kit": "^1.2.0",
    "@types/node": "^26.5.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.0",
    "bootstrap-icons": "^1.13.1",
    "eslint": "^10.10.0",
    "homebridge": "^2.4.0",
    "homebridge-config-ui-x": "^5.29.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@nestjs/platform-fastify": "^12.1.2",
    "fastify": "^5.12.5"
  },
  "funding": {
    "type": "paypal",
    "url": "https://paypal.me/mickaelpalma"
  },
  "files": [
    "dist",
    "homebridge-ui",
    "config.schema.json"
  ]
}
